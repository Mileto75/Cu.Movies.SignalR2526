@page "/movies"
@inject IMovieService MovieService
@inject NavigationManager NavigationManager;
@inject IWebHostEnvironment WebHostEnvironment
<h3>Movies</h3>
<div class="row">
    <div class="col col-lg-2">
        <button class="btn btn-outline-info" @onclick="Create">New</button>
    </div>
</div>

@if (newOrUpdateMovieModel is not null)
{
    <div class="row">
        <div class="col col-lg-5 mx-auto">
            @if (errorMessage is not null)
            {
                <AlertComponent Message="@errorMessage" Style="danger"></AlertComponent>
            }
            @if (message is not null)
            {
                <AlertComponent Message="@errorMessage" Style="info"></AlertComponent>
            }
            <MovieFormComponent NewOrUpdateMovieModel="newOrUpdateMovieModel" OnStoreMovie="StoreMovie" OnCancel="Cancel"></MovieFormComponent>
        </div>
    </div>
}
else
{
    if (movieModels is not null)
    {
        <MovieListComponent MovieModels="movieModels"></MovieListComponent>
    }
    else
    {
        <LoadingComponent></LoadingComponent>
    }
}
@code {
    private IEnumerable<MovieModel> movieModels;
    private MovieModel selectedMovieModel;
    private NewOrUpdateMovieModel newOrUpdateMovieModel;
    private bool isLoading;
    private string errorMessage;
    private string message;
    

    private void Create()
    {
        newOrUpdateMovieModel = new();
        newOrUpdateMovieModel.ReleaseDate = DateTime.Now;
    }
    protected override async Task OnInitializedAsync()
    {
        await GetMovies();
    }
    private async Task GetMovies()
    {
        var result = await MovieService.GetAllAsync();
        if (result.IsSuccess)
        {
            movieModels = result.Data.Select(m => new MovieModel
            {
                Title = m.Title,
                Company = m.Company.Name,
                Id = m.Id,
                Image = m.Image
            });
        }
    }
    private void Cancel()
    {
        newOrUpdateMovieModel = null;
    }
    private async Task StoreMovie(NewOrUpdateMovieModel newOrUpdateMovieModel)
    {
        var image = newOrUpdateMovieModel.BrowserFile;
        var randomName = $"{Guid.NewGuid()}_{image.Name}";
        var pathToImages = Path.Combine(WebHostEnvironment.WebRootPath, "images");
        try
        {
            if (!Directory.Exists(pathToImages))
                Directory.CreateDirectory(pathToImages);
            var PathToFile = Path.Combine(pathToImages, randomName);
            using (FileStream fileStream = new FileStream(PathToFile, FileMode.Create))
            {
                await image.OpenReadStream().CopyToAsync(fileStream);
            }
        }
        catch (IOException iOexception)
        {
            Console.WriteLine(iOexception.Message);
        }
        var result = await MovieService.CreateAsync(newOrUpdateMovieModel.Title,
            newOrUpdateMovieModel.ReleaseDate, newOrUpdateMovieModel.Price, newOrUpdateMovieModel.CompanyId,
            randomName, null, null);
        if (result)
        {
            message = "Movie created!";
        }
        else
        {
            errorMessage = "Movie not created!";
        }
        this.newOrUpdateMovieModel = null;
        await GetMovies();
    }
}